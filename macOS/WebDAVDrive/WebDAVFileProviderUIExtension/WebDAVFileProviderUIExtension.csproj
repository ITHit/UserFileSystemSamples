<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-macos</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>11.0</SupportedOSPlatformVersion>
    <IsAppExtension>True</IsAppExtension>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <_ExportSymbolsExplicitly>false</_ExportSymbolsExplicitly>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug</OutputPath>
    <DefineConstants>DEBUG;</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <EnableCodeSigning>False</EnableCodeSigning>
    <CreatePackage>false</CreatePackage>
    <EnablePackageSigning>false</EnablePackageSigning>
    <IncludeMonoRuntime>false</IncludeMonoRuntime>
    <UseSGen>true</UseSGen>
    <UseRefCounting>true</UseRefCounting>
    <HttpClientHandler></HttpClientHandler>
    <LinkMode>Full</LinkMode>
    <AOTMode>None</AOTMode>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release</OutputPath>
    <DefineConstants></DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <EnableCodeSigning>False</EnableCodeSigning>
    <CreatePackage>true</CreatePackage>
    <EnablePackageSigning>false</EnablePackageSigning>
    <IncludeMonoRuntime>true</IncludeMonoRuntime>
    <UseSGen>true</UseSGen>
    <UseRefCounting>true</UseRefCounting>
    <CodeSignEntitlements>Entitlements.plist</CodeSignEntitlements>
    <LinkMode>None</LinkMode>
    <HttpClientHandler></HttpClientHandler>
    <AOTMode>None</AOTMode>
    <LangVersion>12.0</LangVersion>
    <UseHardenedRuntime>true</UseHardenedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="ViewControllers\" />
    <None Remove="Resources\" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Entitlements.plist">
      <Link>$([MSBuild]::MakeRelative ('$(MSBuildProjectDirectory)', '%(Identity)'))</Link>
    </None>
    <None Update="Info.plist">
      <Link>$([MSBuild]::MakeRelative ('$(MSBuildProjectDirectory)', '%(Identity)'))</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="ViewControllers\" />
    <Folder Include="Resources\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Common\Core\Common.Core.csproj" />
    <ProjectReference Include="..\WebDAVCommon\WebDAVCommon.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ITHit.FileSystem.Mac" Version="9.2.29658" />
  </ItemGroup>
    <ItemGroup>
      <Content Include="..\WebDAVMacApp\Resources\appsettings.json" Link="Resources\appsettings.json" />
  </ItemGroup>
  <!-- AfterBuild signing as MSBuild targets so they run under `dotnet build`
       (the old <CustomCommands> were VS-for-Mac only and ignored by dotnet build). -->
  <Target Name="SignUIExtensionDebug" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="bash &quot;$(ProjectDir)/sign.sh&quot; &quot;$(TargetDir)&quot;" />
    <Exec Command="codesign --force --sign - -o runtime --entitlements &quot;$(ProjectDir)/Entitlements.plist&quot; --timestamp --generate-entitlement-der &quot;$(TargetDir)/WebDAVFileProviderUIExtension.appex&quot;" />
  </Target>
  <Target Name="SignUIExtensionRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="rm -f &quot;$(TargetDir)/WebDAVFileProviderUIExtension.appex/Contents/MonoBundle/createdump&quot;" />
    <Exec Command="cp -rf &quot;$(ProjectDir)/embedded.provisionprofile&quot; &quot;$(TargetDir)/WebDAVFileProviderUIExtension.appex/Contents&quot;" />
    <Exec Command="bash &quot;$(ProjectDir)/sign_release.sh&quot; &quot;$(TargetDir)&quot;" />
    <Exec Command="codesign --force --sign &quot;Apple Distribution&quot; -o runtime --entitlements &quot;$(ProjectDir)/Entitlements.plist&quot; --timestamp --generate-entitlement-der &quot;$(TargetDir)/WebDAVFileProviderUIExtension.appex&quot;" />
  </Target>
</Project>
